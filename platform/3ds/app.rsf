# CIA metadata for makerom.
#
# The filesystem access rights below are the entire reason this project ships a
# CIA rather than a 3dsx: a 3dsx cannot reach another title's save archive, and no
# amount of code works around that.
#
# The exact set needed is a Phase 1 question that only hardware can answer. What is
# here is the set save managers conventionally use, and it is deliberately no wider
# than that: every extra right is one more thing an app that writes to save data
# can get wrong. Narrow it if hardware shows something is unnecessary, and record
# what was actually required.

BasicInfo:
  Title                   : DaeMoon
  ProductCode             : CTR-P-DAEM
  Logo                    : Nintendo

TitleInfo:
  Category                : Application
  UniqueId                : 0xDAE00

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCompress          : true
  EnableCrypt             : false

AccessControlInfo:
  CoreVersion             : 2

  # The exheader format and the kernel this build expects. makerom picks an
  # access descriptor template from these, and the template is what caps the
  # rights actually granted at runtime.
  DescVersion             : 2
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "46"

  # Reaching other titles' save archives. CategorySystemApplication is what lets
  # FSUSER_OpenArchive open a save that does not belong to this title;
  # DirectSdmc and DirectSdmcWrite are for the backups, staging and state files.
  #
  # The set above is wider than this project wants, and it is deliberate for now.
  #
  # Three rights - CategorySystemApplication, DirectSdmc, DirectSdmcWrite - are
  # enough to open and rewrite every save archive on the console, which is the
  # dangerous half. They are not enough to read another title's SMDH: hardware
  # returned "not supported" for all sixteen titles, so the whole library showed
  # up as product codes. Adding Core alone did not change it.
  #
  # This now matches Checkpoint, which is known to work. That is a starting point
  # and not an answer: the survey records the raw Result for every failed lookup,
  # so narrowing this back down is a measurable experiment rather than a guess,
  # and it should be done. Every right here is one more thing an application that
  # writes to save data can get wrong.
  FileSystemAccess:
    - CategorySystemApplication
    - CategoryHardwareCheck
    - CategoryFileSystemTool
    - Debug
    - TwlCardBackup
    - TwlNandData
    - Boss
    - DirectSdmc
    - Core
    - CtrNandRo
    - CtrNandRw
    - CtrNandRoWrite
    - CategorySystemSettings
    - CardBoard
    - ExportImportIvs
    - DirectSdmcWrite
    - SwitchCleanup
    - SaveDataMove
    - Shop
    - Shell
    - CategoryHomeMenu
    - SeedDB

  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  MaxCpu                  : 0

  MemoryType              : Application
  SystemMode              : 64MB
  SystemModeExt           : Legacy

  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : false
  SpecialMemoryArrange    : false
  HandleTableSize         : 512
  ResourceLimitCategory   : Application

  # ARM9 access.
  #
  # Reading another title's content is not purely an ARM11 filesystem operation:
  # the NCCH is decrypted by the ARM9, and without these the request comes back
  # as fs/not_supported (0xE0C046F8) no matter how many FileSystemAccess bits are
  # set. That is what sixteen titles' worth of product codes turned out to mean.
  #
  # As with the filesystem list above, this matches a reference that works and is
  # wider than this project wants to end up. Narrowing both is one experiment,
  # and the survey records the raw Result that makes it measurable.
  IoAccessControl:
    - FsMountNand
    - FsMountNandRoWrite
    - FsMountTwln
    - FsMountWnand
    - FsMountCardSpi
    - UseSdif3
    - CreateSeed
    - UseCardSpi

  # The conventional homebrew syscall set. It is not tuned: trimming it would take
  # measuring what libctru actually issues, and a missing syscall is a crash on
  # hardware rather than a build failure here.
  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessIdealProcessor: 6
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    SetThreadPriority: 12
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37

  InterruptNumbers:
  MemoryMapping:

  # cam:u is here for Phase 4 QR pairing, and nothing uses it before then.
  # soc:U and ssl:C are for Phase 2 onwards, when the client talks to a server.
  ServiceAccessControl:
    - am:u
    - cfg:u
    - fs:USER
    - hid:USER
    - ndm:u
    - ptm:u
    - gsp::Gpu
    - APT:U
    - ac:u
    - soc:U
    - ssl:C
    - cam:u
    - y2r:u

SystemControlInfo:
  # Substituted by the Makefile. The shipped app keeps its state on the SD card
  # and needs no save archive of its own, so this is 0K. A test build asks for a
  # small one, which gives the self test an archive it owns and can safely
  # destroy - see docs/phase1-hardware.md.
  SaveDataSize: $(SAVEDATA_SIZE)
  RemasterVersion: 0
  StackSize: 0x40000
